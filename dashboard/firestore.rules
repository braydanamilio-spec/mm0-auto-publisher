rules_version = '2';
// ============================================================================
//  BẢO MẬT FIRESTORE — MULTI-TENANT + RBAC (đội nhóm)
//  Mọi doc dữ liệu có field `owner` = uid CHỦ workspace.
//  Thành viên (team_members/{owner}__{memberUid}) truy cập theo VAI TRÒ:
//    admin  = toàn quyền · editor = đọc + sửa/đăng nội dung · viewer = chỉ đọc.
//  Server/Worker ghi qua Admin/REST -> bỏ qua rules (tokens vẫn kín).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function owns(data) { return signedIn() && data.owner == uid(); }
    function willOwn()  { return signedIn() && request.resource.data.owner == uid(); }

    // ---- RBAC helpers ----
    function memPath(ownerUid) { return /databases/$(database)/documents/team_members/$(ownerUid + '__' + uid()); }
    function isMember(ownerUid) { return signedIn() && exists(memPath(ownerUid)); }
    function roleOf(ownerUid) { return get(memPath(ownerUid)).data.role; }
    function canRead(ownerUid) { return signedIn() && (ownerUid == uid() || isMember(ownerUid)); }
    function canEdit(ownerUid) { return signedIn() && (ownerUid == uid() || (isMember(ownerUid) && roleOf(ownerUid) in ['admin','editor'])); }
    function canAdmin(ownerUid) { return signedIn() && (ownerUid == uid() || (isMember(ownerUid) && roleOf(ownerUid) == 'admin')); }

    // Video — đọc (chủ+thành viên); editor/admin được DUYỆT/sửa metadata.
    match /videos/{doc} {
      allow read: if canRead(resource.data.owner);
      allow update: if canEdit(resource.data.owner)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'publish_at', 'reviewed_at',
                       'title', 'description', 'tags', 'hashtags', 'edited', 'updated_at',
                       'privacy', 'made_for_kids', 'language', 'category', 'location']);
      allow create, delete: if false;
    }

    // Chỉ đọc (server ghi) — chủ + mọi thành viên đọc được.
    match /channels/{doc}         { allow read: if canRead(resource.data.owner); allow write: if false; }
    match /counters/{doc}         { allow read: if canRead(resource.data.owner); allow write: if false; }
    match /storage/{doc}          { allow read: if canRead(resource.data.owner); allow write: if false; }
    match /storage_accounts/{doc} { allow read: if canRead(resource.data.owner); allow write: if false; }
    match /fb_pages/{doc}         { allow read: if canRead(resource.data.owner); allow write: if false; }
    match /quota/{doc}            { allow read: if canRead(resource.data.owner); allow write: if false; }

    // Hàng đợi đăng FB/IG — editor/admin tạo/sửa/xoá; viewer chỉ đọc.
    match /social_queue/{doc} {
      allow read: if canRead(resource.data.owner);
      allow create: if canEdit(request.resource.data.owner);
      allow update: if canEdit(resource.data.owner) && canEdit(request.resource.data.owner);
      allow delete: if canEdit(resource.data.owner);
    }
    // Content Hub — hàng đợi đăng YouTube từ Drive.
    match /yt_queue/{doc} {
      allow read: if canRead(resource.data.owner);
      allow create: if canEdit(request.resource.data.owner);
      allow update: if canEdit(resource.data.owner) && canEdit(request.resource.data.owner);
      allow delete: if canEdit(resource.data.owner);
    }
    // Giao việc (Kanban) — editor/admin quản lý; viewer chỉ đọc.
    match /tasks/{doc} {
      allow read: if canRead(resource.data.owner);
      allow create: if canEdit(request.resource.data.owner);
      allow update: if canEdit(resource.data.owner) && canEdit(request.resource.data.owner);
      allow delete: if canEdit(resource.data.owner);
    }

    // Link rút gọn thương hiệu — chủ+thành viên đọc; editor/admin tạo/sửa/xoá của mình.
    //   Worker đọc + tăng click qua service account (bỏ qua rules). Mã (doc id) TOÀN CỤC duy nhất:
    //   nếu mã đã thuộc owner khác -> setDoc thành 'update' -> owns() chặn -> không cướp được mã.
    match /links/{code} {
      // resource == null: doc CHƯA tồn tại -> cho đọc (trả null) để client kiểm tra trùng mã trước khi tạo.
      allow read:   if resource == null || canRead(resource.data.owner);
      allow create: if canEdit(request.resource.data.owner);
      allow update: if owns(resource.data) && canEdit(request.resource.data.owner);
      allow delete: if owns(resource.data);
    }

    // TOKEN kết nối — không client nào đọc/ghi (chỉ server/Worker qua Admin).
    match /connections/{doc}      { allow read, write: if false; }

    // Cấu hình (overrides__<owner>) — đọc: chủ+thành viên; ghi: editor/admin.
    match /settings/{doc} {
      allow read: if canRead(resource.data.owner);
      allow write: if canEdit(request.resource.data.owner)
        && doc == ('overrides__' + request.resource.data.owner);
    }

    // ---- ĐỘI NHÓM ----
    // Lời mời (mã code) — chủ tạo/sửa/xoá; người đăng nhập đọc được để nhập mã tham gia.
    match /team_invites/{doc} {
      allow read:   if signedIn();
      allow create: if willOwn();
      allow update, delete: if owns(resource.data);
    }
    // Thành viên — chủ quản lý; thành viên tự THAM GIA qua lời mời hợp lệ.
    match /team_members/{doc} {
      allow read:   if owns(resource.data) || (signedIn() && resource.data.member_uid == uid()) || isMember(resource.data.owner);
      allow create: if signedIn()
        && request.resource.data.member_uid == uid()
        && doc == (request.resource.data.owner + '__' + uid())
        && exists(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_id))
        && get(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_id)).data.owner == request.resource.data.owner
        && get(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_id)).data.role == request.resource.data.role;
      allow update: if owns(resource.data) && request.resource.data.member_uid == resource.data.member_uid;
      allow delete: if owns(resource.data) || (signedIn() && resource.data.member_uid == uid());
    }
  }
}
