rules_version = '2';
// ============================================================================
//  BẢO MẬT FIRESTORE
//  - Chỉ CHỦ (email của bạn) được ĐỌC dashboard.
//  - KHÔNG ai ghi được từ client (chỉ backend/service account qua Admin SDK ghi).
//  👉 Đổi "YOUR_EMAIL@gmail.com" thành email Google bạn dùng đăng nhập dashboard.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 👉 Thêm/bớt email được xem dashboard tại đây rồi deploy lại.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
             "braydanamilio@gmail.com",
             "adisondurham@gmail.com"
           ];
    }

    match /videos/{doc} {
      allow read: if isOwner();
      // Chủ được DUYỆT: chỉ đổi status/publish_at/reviewed_at, không đụng field khác.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'publish_at', 'reviewed_at']);
      allow create, delete: if false;   // service account (Admin) bỏ qua rules
    }
    match /counters/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    // TOKEN kết nối — TUYỆT ĐỐI không cho client đọc/ghi.
    // Chỉ service account (pipeline) + Worker ghi qua Admin/REST (bỏ qua rules).
    match /connections/{doc} {
      allow read, write: if false;
    }
    match /storage/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /settings/{doc} {
      allow read: if isOwner();
      // chỉ cho chủ ghi doc 'overrides' (chọn template per-kênh từ dashboard)
      allow write: if isOwner() && doc == "overrides";
    }
  }
}
