rules_version = '2';
// ============================================================================
//  BẢO MẬT FIRESTORE
//  - Chỉ CHỦ (email của bạn) được ĐỌC dashboard.
//  - KHÔNG ai ghi được từ client (chỉ backend/service account qua Admin SDK ghi).
//  👉 Đổi "YOUR_EMAIL@gmail.com" thành email Google bạn dùng đăng nhập dashboard.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 👉 Thêm/bớt email được xem dashboard tại đây rồi deploy lại.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
             "braydanamilio@gmail.com",
             "adisondurham@gmail.com"
           ];
    }

    match /videos/{doc} {
      allow read: if isOwner();
      allow write: if false;   // service account bỏ qua rules (Admin) => vẫn ghi được
    }
    match /counters/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    // TOKEN kết nối — TUYỆT ĐỐI không cho client đọc/ghi.
    // Chỉ service account (pipeline) + Worker ghi qua Admin/REST (bỏ qua rules).
    match /connections/{doc} {
      allow read, write: if false;
    }
    match /storage/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /settings/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
