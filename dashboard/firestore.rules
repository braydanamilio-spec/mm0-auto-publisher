rules_version = '2';
// ============================================================================
//  BẢO MẬT FIRESTORE — MULTI-TENANT (mỗi user chỉ thấy dữ liệu của mình)
//  Mọi doc có field `owner` = uid. Rules chặn đọc/ghi chéo giữa các user.
//  Service account (pipeline) + Worker ghi qua Admin/REST -> bỏ qua rules.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.owner == request.auth.uid; }
    function willOwn()  { return signedIn() && request.resource.data.owner == request.auth.uid; }

    // Video — chủ đọc; chỉ được DUYỆT (đổi status/publish_at/reviewed_at)
    match /videos/{doc} {
      allow read: if owns(resource.data);
      allow update: if owns(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'publish_at', 'reviewed_at',
                       'title', 'description', 'tags', 'hashtags', 'edited', 'updated_at',
                       'privacy', 'made_for_kids', 'language', 'category', 'location']);
      allow create, delete: if false;
    }

    match /channels/{doc}         { allow read: if owns(resource.data); allow write: if false; }
    match /counters/{doc}         { allow read: if owns(resource.data); allow write: if false; }
    match /storage/{doc}          { allow read: if owns(resource.data); allow write: if false; }
    match /storage_accounts/{doc} { allow read: if owns(resource.data); allow write: if false; }
    match /fb_pages/{doc}         { allow read: if owns(resource.data); allow write: if false; }

    // Hàng đợi đăng FB/IG độc lập — chủ tự tạo/sửa/xoá item của mình (KHÔNG chứa token).
    match /social_queue/{doc} {
      allow read, delete: if owns(resource.data);
      allow create: if willOwn();
      allow update: if owns(resource.data) && willOwn();
    }

    // Content Hub — hàng đợi đăng YouTube từ Drive (KHÔNG chứa token).
    match /yt_queue/{doc} {
      allow read, delete: if owns(resource.data);
      allow create: if willOwn();
      allow update: if owns(resource.data) && willOwn();
    }
    match /quota/{doc}            { allow read: if owns(resource.data); allow write: if false; }

    // TOKEN kết nối — không client nào đọc/ghi (chỉ server/Worker qua Admin).
    match /connections/{doc}      { allow read, write: if false; }

    // Cấu hình: chủ đọc doc của mình; chỉ được ghi doc overrides__<uid> của chính mình.
    match /settings/{doc} {
      allow read: if owns(resource.data);
      allow write: if willOwn() && doc == ('overrides__' + request.auth.uid);
    }
  }
}
